{
  "id": "test",
  "version": "1",
  "title": "Test Campaign",
  "premise": "A minimal systems-only campaign used to validate quest state and dialogue state alignment.",
  "description": "Tiny deterministic runtime probe with no narration-heavy behavior.",
  "tone": "test",
  "character_creation": {
    "use_standard_creator": true,
    "allowed_classes": ["fighter", "barbarian", "monk"],
    "allowed_races": ["human", "dwarf"],
    "allowed_subraces": ["hill-dwarf", "mountain-dwarf"],
    "theme_hint_mode": "disabled",
    "preference_mode": "disabled"
  },
  "player_role": {
    "name": "Test Adventurer",
    "premise": "You are entering a controlled proof-of-concept adventure.",
    "role_summary": "Simple, direct, and easy to test."
  },
  "party": {
    "max_human_players": 1,
    "starting_room_id": "camp",
    "companion_ids": ["guide"]
  },
  "map": {
    "rooms": {
      "camp": {
        "name": "Camp",
        "floor": 0,
        "type": "briefing",
        "connections": {
          "east": "crossroads"
        }
      },
      "crossroads": {
        "name": "Crossroads",
        "floor": 1,
        "type": "junction",
        "connections": {
          "west": "camp",
          "east": "relic_room"
        }
      },
      "relic_room": {
        "name": "Relic Room",
        "floor": 1,
        "type": "chamber",
        "connections": {
          "west": "crossroads"
        }
      }
    },
    "entrances": [
      {
        "id": "main_path",
        "name": "Main Path",
        "start_room_id": "camp"
      }
    ]
  },
  "actors": {
    "guide": {
      "name": "Guide",
      "kind": "companion",
      "goal": "Guide the player through a tiny deterministic state test.",
      "importance": "primary"
    },
    "caretaker": {
      "name": "Caretaker",
      "kind": "npc",
      "goal": "Stand in the relic room as a static authored endpoint.",
      "importance": "secondary"
    }
  },
  "objectives": {
    "finish_intro": {
      "title": "Complete Intro",
      "description": "Advance from the intro node to the relic prompt node."
    },
    "reach_relic_prompt": {
      "title": "Reach Relic Prompt",
      "description": "Advance from the relic prompt node to completion."
    },
    "complete_test": {
      "title": "Complete Test",
      "description": "Confirm the systems-only state machine finishes cleanly."
    }
  },
  "dialogue_assets": {
    "intro_dialogue": {
      "format": "yarn",
      "program": "dialogue/intro.yarnc",
      "strings": "dialogue/intro.csv"
    },
    "relic_dialogue": {
      "format": "yarn",
      "program": "dialogue/relic.yarnc",
      "strings": "dialogue/relic.csv"
    }
  },
  "story_nodes": {
    "intro": {
      "mode": "yarn_dialogue",
      "dialogue_asset_id": "intro_dialogue",
      "dialogue_start_node": "Intro",
      "title": "Intro",
      "summary": "The first deterministic systems check.",
      "objective_text": "Send a message containing proceed to move to the relic prompt node.",
      "on_enter": [
        { "type": "activate_objective", "objective_id": "finish_intro" },
        { "type": "start_dialogue", "asset_id": "intro_dialogue", "start_node": "Intro" }
      ],
      "allowed_conditions": [
        { "type": "flag_true", "key": "intro_complete" }
      ],
      "completion_rules": [
        {
          "conditions": [
            { "type": "flag_true", "key": "intro_complete" }
          ],
          "next_node_id": "relic_prompt",
          "actions": [
            { "type": "complete_objective", "objective_id": "finish_intro" },
            { "type": "activate_objective", "objective_id": "reach_relic_prompt" }
          ]
        }
      ]
    },
    "relic_prompt": {
      "mode": "yarn_dialogue",
      "dialogue_asset_id": "relic_dialogue",
      "dialogue_start_node": "RelicPrompt",
      "title": "Relic Prompt",
      "summary": "The second deterministic systems check.",
      "objective_text": "Send a message containing take relic to complete the test flow.",
      "on_enter": [
        { "type": "start_dialogue", "asset_id": "relic_dialogue", "start_node": "RelicPrompt" }
      ],
      "allowed_conditions": [
        { "type": "flag_true", "key": "relic_taken" }
      ],
      "completion_rules": [
        {
          "conditions": [
            { "type": "flag_true", "key": "relic_taken" }
          ],
          "next_node_id": "complete",
          "actions": [
            { "type": "complete_objective", "objective_id": "reach_relic_prompt" },
            { "type": "activate_objective", "objective_id": "complete_test" },
            { "type": "complete_objective", "objective_id": "complete_test" }
          ]
        }
      ]
    },
    "complete": {
      "mode": "ai_scene",
      "title": "Complete",
      "summary": "The systems-only runtime test finishes cleanly.",
      "objective_text": "The systems-only runtime test is complete."
    }
  },
  "start_node_id": "intro",
  "intro_sequence": {
    "mode": "systems_probe",
    "opening_node_id": "intro",
    "opening_text": "This campaign is a minimal runtime probe for node state and dialogue state."
  }
}
