{
  "id": "test",
  "version": "1",
  "title": "Test Campaign",
  "premise": "A minimal campaign used to validate campaign loading, deterministic node transitions, and dialogue integration.",
  "description": "Small POC campaign with easy-to-hit conditions and a tiny room graph.",
  "tone": "test",
  "character_creation": {
    "use_standard_creator": true,
    "allowed_classes": ["fighter", "barbarian", "monk"],
    "allowed_races": ["human", "dwarf"],
    "allowed_subraces": ["hill-dwarf", "mountain-dwarf"],
    "theme_hint_mode": "disabled",
    "preference_mode": "disabled"
  },
  "player_role": {
    "name": "Test Adventurer",
    "premise": "You are entering a controlled proof-of-concept adventure.",
    "role_summary": "Simple, direct, and easy to test."
  },
  "party": {
    "max_human_players": 1,
    "starting_room_id": "camp",
    "companion_ids": ["guide"]
  },
  "map": {
    "rooms": {
      "camp": {
        "name": "Camp",
        "floor": 0,
        "type": "briefing",
        "connections": {
          "east": "crossroads"
        }
      },
      "crossroads": {
        "name": "Crossroads",
        "floor": 1,
        "type": "junction",
        "connections": {
          "west": "camp",
          "east": "relic_room"
        }
      },
      "relic_room": {
        "name": "Relic Room",
        "floor": 1,
        "type": "chamber",
        "connections": {
          "west": "crossroads"
        }
      }
    },
    "entrances": [
      {
        "id": "main_path",
        "name": "Main Path",
        "start_room_id": "camp"
      }
    ]
  },
  "actors": {
    "guide": {
      "name": "Guide",
      "kind": "companion",
      "goal": "Help the player complete the test flow.",
      "importance": "primary"
    },
    "caretaker": {
      "name": "Caretaker",
      "kind": "npc",
      "goal": "Guard the relic room until the player arrives.",
      "importance": "secondary"
    }
  },
  "objectives": {
    "finish_intro": {
      "title": "Finish Intro",
      "description": "Complete the opening scene."
    },
    "choose_path": {
      "title": "Choose Path",
      "description": "Pick the easy path forward."
    },
    "grab_relic": {
      "title": "Grab Relic",
      "description": "Reach the relic room and complete the test objective."
    }
  },
  "dialogue_assets": {
    "intro_dialogue": {
      "format": "yarn",
      "program": "dialogue/intro.yarnc",
      "strings": "dialogue/intro.csv"
    }
  },
  "story_nodes": {
    "intro": {
      "mode": "hybrid",
      "dialogue_asset_id": "intro_dialogue",
      "dialogue_start_node": "Intro",
      "title": "Intro",
      "summary": "A tiny opening scene that should be easy to complete during testing.",
      "objective_text": "Conclude the intro and agree to proceed.",
      "on_enter": [
        { "type": "activate_objective", "objective_id": "finish_intro" },
        { "type": "start_dialogue", "asset_id": "intro_dialogue", "start_node": "Intro" }
      ],
      "allowed_conditions": [
        { "type": "flag_true", "key": "intro_complete" }
      ],
      "completion_rules": [
        {
          "conditions": [
            { "type": "flag_true", "key": "intro_complete" }
          ],
          "next_node_id": "choose_path",
          "actions": [
            { "type": "complete_objective", "objective_id": "finish_intro" },
            { "type": "activate_objective", "objective_id": "choose_path" }
          ]
        }
      ]
    },
    "choose_path": {
      "mode": "ai_scene",
      "title": "Choose Path",
      "summary": "A simple scene where the player picks the obvious path forward.",
      "objective_text": "Choose the main path.",
      "allowed_conditions": [
        { "type": "label_equals", "key": "path_choice", "allowed_values": ["main"] }
      ],
      "completion_rules": [
        {
          "conditions": [
            { "type": "label_equals", "key": "path_choice", "value": "main" }
          ],
          "next_node_id": "retrieve_relic",
          "actions": [
            { "type": "complete_objective", "objective_id": "choose_path" },
            { "type": "activate_objective", "objective_id": "grab_relic" }
          ]
        }
      ]
    },
    "retrieve_relic": {
      "mode": "ai_scene",
      "title": "Retrieve Relic",
      "summary": "A minimal end-state scene with one easy success condition.",
      "objective_text": "Take the relic.",
      "allowed_conditions": [
        { "type": "flag_true", "key": "relic_taken" }
      ],
      "completion_rules": [
        {
          "conditions": [
            { "type": "flag_true", "key": "relic_taken" }
          ],
          "next_node_id": "complete",
          "actions": [
            { "type": "complete_objective", "objective_id": "grab_relic" }
          ]
        }
      ]
    },
    "complete": {
      "mode": "ai_scene",
      "title": "Complete",
      "summary": "The test campaign finishes cleanly.",
      "objective_text": "The test flow is complete."
    }
  },
  "start_node_id": "intro",
  "intro_sequence": {
    "mode": "streamed_briefing",
    "opening_node_id": "intro",
    "opening_text": "This is the smallest authored campaign needed to validate the Phase 7 runtime.",
    "opening_choices": {
      "path_choice": ["main"]
    }
  }
}
